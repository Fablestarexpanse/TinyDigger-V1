// GPU grass placement (Ronan, 2026-09-24: "really nice grass … that doesn't bog the system down").
//
// One thread per spot of a jittered grid round the camera. The grid is snapped to whole spacings in
// world space and every choice comes from a hash of the spot, so a blade stays where it is as the
// camera moves: nothing swims. A spot becomes a clump when:
//   - its cell's top material is grass (the cell map's red channel), so a dig or a tip clears it;
//   - the ground there is not too steep;
//   - it is inside the view frustum;
//   - it survives thinning: full density to _Near, falling to none at _Far, by a stable hash.
// Its colour is the ground's: the same lush and dry patches and hollow darkening the terrain shader
// draws, so the grass grows out of the ground rather than sitting on it.
#pragma kernel Spawn

struct GrassInstance
{
    float3 position;
    float rotation;
    float3 colour;
    float scale;
};

AppendStructuredBuffer<GrassInstance> _Instances;

Texture2D<float4> _CellMap;
Texture2D<float> _Heights;
Texture2D<float> _HollowMap;
SamplerState sampler_linear_clamp;

float4 _MapSize;        // x, y: cells across and down
float4 _TerrainOrigin;  // xy: world xz of the grid origin, z: cells per metre, w: world y of the grid's zero
float4 _Eye;            // xyz: camera position
float4 _Range;          // x: full density to (m), y: none beyond (m), z: spacing (m), w: grid side (spots)
float4 _GridOrigin;     // xy: world xz of spot (0, 0)
float4 _Planes[6];
float4 _Grass;          // x: grass material id, y: cos of the steepest slope with grass, z: min scale, w: max scale
float4 _Meadow;
float4 _Lush;
float4 _Dry;
float4 _Variants;       // x: patch size (m), y: amount, z: dry from (m), w: dry to (m)
float4 _Hollows;        // x: strength
float4 _HollowColour;

float Hash21(float2 p)
{
    p = frac(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return frac(p.x * p.y);
}

float ValueNoise(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    return lerp(lerp(Hash21(i), Hash21(i + float2(1, 0)), f.x), lerp(Hash21(i + float2(0, 1)), Hash21(i + float2(1, 1)), f.x), f.y);
}

float HeightAt(float2 cell)
{
    // Texel (i, j) is corner (i, j), which sits at cell coordinate (i, j).
    float2 uv = (cell + 0.5) / (_MapSize.xy + 1.0);
    return _Heights.SampleLevel(sampler_linear_clamp, uv, 0) + _TerrainOrigin.w;
}

[numthreads(8, 8, 1)]
void Spawn(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Range.w || id.y >= (uint)_Range.w)
        return;

    float2 spot = _GridOrigin.xy / _Range.z + float2(id.xy);
    float2 world = (spot + float2(Hash21(spot), Hash21(spot + 71.3)) * 0.9) * _Range.z;

    float2 cell = (world - _TerrainOrigin.xy) * _TerrainOrigin.z;
    if (any(cell < 0.0) || any(cell >= _MapSize.xy))
        return;
    float material = floor(_CellMap.Load(int3(int2(cell), 0)).r * 255.0 + 0.5);
    if (abs(material - _Grass.x) > 0.5)
        return;

    float3 position = float3(world.x, HeightAt(cell), world.y);

    // Thinning with distance: a spot's own hash against how much of the grass survives here.
    float distance = length(position - _Eye.xyz);
    float keep = saturate(1.0 - (distance - _Range.x) / max(_Range.y - _Range.x, 0.01));
    float chance = Hash21(spot + 13.7);
    if (chance > keep)
        return;

    [unroll]
    for (int p = 0; p < 6; p++)
        if (dot(_Planes[p].xyz, position) + _Planes[p].w < -0.5)
            return;

    // Too steep for turf: the slope from the surface on either side.
    float step = 0.5;
    float dx = HeightAt(cell + float2(step, 0)) - HeightAt(cell - float2(step, 0));
    float dz = HeightAt(cell + float2(0, step)) - HeightAt(cell - float2(0, step));
    float3 normal = normalize(float3(-dx, 2.0 * step / _TerrainOrigin.z, -dz));
    if (normal.y < _Grass.y)
        return;

    // The ground's colour here, as the terrain shader works it out.
    float2 variantAt = world / _Variants.x;
    float lushField = ValueNoise(variantAt) * 0.6 + ValueNoise(variantAt * 0.35 + 31.0) * 0.4;
    float dryField = ValueNoise(variantAt + 57.0) * 0.6 + ValueNoise(variantAt * 0.35 + 93.0) * 0.4;
    float highGround = saturate((position.y - _Variants.z) / max(_Variants.w - _Variants.z, 0.01));
    float dryWeight = smoothstep(0.36, 0.64, dryField + highGround * 0.35 - 0.08) * _Variants.y;
    float lushWeight = smoothstep(0.36, 0.64, lushField - highGround * 0.3 - 0.04) * (1.0 - dryWeight) * _Variants.y;
    float3 colour = _Meadow.rgb;
    colour = lerp(colour, _Lush.rgb, lushWeight);
    colour = lerp(colour, _Dry.rgb, dryWeight);

    float hollowValue = _HollowMap.SampleLevel(sampler_linear_clamp, cell / _MapSize.xy, 0);
    float hollow = saturate(hollowValue * 2.0 - 1.0);
    colour *= lerp(float3(1, 1, 1), _HollowColour.rgb, hollow * _Hollows.x);
    // A little per-clump variation, so neighbours are not identical.
    colour *= 0.88 + 0.24 * Hash21(spot + 5.1);

    GrassInstance instance;
    instance.position = position;
    instance.rotation = Hash21(spot + 29.9) * 6.2831853;
    // Taller in the lush patches and hollows, shorter on dry ground; shrinks to nothing at the far
    // edge so the grass fades out instead of popping.
    float size = lerp(_Grass.z, _Grass.w, Hash21(spot + 3.3)) * (1.0 + 0.35 * lushWeight + 0.25 * hollow - 0.3 * dryWeight);
    instance.scale = size * saturate(keep * 3.0);
    instance.colour = colour;
    _Instances.Append(instance);
}
